<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AutoReplyBot" parent="Theme.MaterialComponents.Light.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryVariant</item>
        <item name="colorOnPrimary">@color/colorOnPrimary</item>
        <item name="colorSecondary">@color/colorSecondary</item>
        <item name="colorSecondaryVariant">@color/colorSecondaryVariant</item>
        <item name="colorOnSecondary">@color/colorOnSecondary</item>
        <item name="android:colorBackground">@color/colorBackground</item>
        <item name="colorOnBackground">@color/colorOnBackground</item>
        <item name="colorSurface">@color/colorSurface</item>
        <item name="colorOnSurface">@color/colorOnSurface</item>
        <item name="colorError">@color/colorError</item>
        <item name="colorOnError">@color/colorOnError</item>
        <item name="android:statusBarColor">@color/accent_dark</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="actionBarStyle">@style/AutoReplyActionBar</item>
    </style>

    <style name="AutoReplyActionBar" parent="Widget.MaterialComponents.ActionBar.Solid">
        <item name="background">@color/accent_dark</item>
        <item name="titleTextStyle">@style/AutoReplyActionBarTitle</item>
    </style>

    <style name="AutoReplyActionBarTitle" parent="TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">18sp</item>
    </style>
</resources>
